int Random(int min, int max)
{
	int rand_int = rand() % max + min;
	return rand_int;
}

void RandomPlace()
{
	int min_i{1};
	int max_i{0};
	int min_j{2};
	int max_j{0};
	int map_i = GetMapI();
	int map_j = GetMapJ();
	for (int i = 0; i < map_i; i++)
	{
		for (int j = 0; j < map_j; j++)
		{
			if (i == 1 && j == 1)
			{
				new_arr[i][j] = "P";
			}

			if (new_arr[i][j] == ".")
			{
				if (i > 0 && j == 2 && i < (map_i - 1))
				{
					max_i++;
				}
				if (j > 1 && i == 2)
				{
					max_j++;
				}
			}
		}
	}
	new_arr[Random(min_i, max_i)][Random(min_j, max_j)] = "E";
	new_arr[Random(min_i, max_i)][Random(min_j, max_j)] = "A";
	new_arr[Random(min_i, max_i)][Random(min_j, max_j)] = "p";
}

