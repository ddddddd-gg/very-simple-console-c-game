void GenerateMap(int h, int w)
{
	int nh = h;
	if (h < 8)
	{
		nh += (h + (7 - h));
	}
	//generating map
	for (int i = 0; i < nh; i++)
	{
		for (int j = 0; j < (w + 23); j++) //23 is a max quantity of characters of menu
		{
			if (i == 0 || i == (h - 1))
			{
				if (j < w)
				{
					gen_map[i][j] = "#";
				}
			}

			if (j == 0 || j == (w - 1))
			{
				if (i > 0 && i < (h - 1))
				{
					gen_map[i][j] = "#";
				}
			}

			if (i > 0 && i < (h - 1))
			{
				if (j > 0 && j < (w - 1))
				{
					gen_map[i][j] = ".";
				}
			}

			if (j == w)
			{
				if (i >= 0 && i < 7)
				{
					gen_map[i][j] = "|";
				}
			}

			if (j > w)
			{
				if (i == 0 || i == 6 || i == 4)
				{
					gen_map[i][j] = "#";
				}
			}

			if (i > (h - 1) && j < w) //it's crutches, but...
			{
				gen_map[i][j] = " ";
			}

			if (i == 1 && j == (w + 1))
			{
				gen_map[i][j] = "Name: ";
			}

			if (i == 2 && j == (w + 1))
			{
				gen_map[i][j] = "HP: ";
				gen_map[i][j + 1] = "100";
			}

			if (i == 3 && j == (w + 1))
			{
				gen_map[i][j] = "DMG: ";
				gen_map[i][j + 1] = "25";
			}

			if (i == 5 && j == (w + 1))
			{
				gen_map[i][j] = " w - ↑ |a - ← |s - ↓ |d - →";
			}
		}
	}
}

